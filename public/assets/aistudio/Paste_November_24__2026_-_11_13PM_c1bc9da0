    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuBtn && mobileMenu) menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));

    function runSearch() {
      const q = document.getElementById('search-query').value.trim() || 'Cashmere';
      document.getElementById('query-label').textContent = q;
    }

    function quickFilter(dept, btn) {
      document.querySelectorAll('.search-chip').forEach(c => {
        c.className = 'search-chip px-4 py-1.5 rounded-full border border-outline-variant text-on-surface font-label text-label-sm uppercase tracking-wider hover:border-primary';
      });
      btn.className = 'search-chip px-4 py-1.5 rounded-full bg-primary text-on-primary font-label text-label-sm uppercase tracking-wider';

      let visible = 0;
      document.querySelectorAll('.search-card').forEach(card => {
        const match = dept === 'all' || card.dataset.dept === dept;
        card.classList.toggle('hidden', !match);
        if (match) visible++;
      });
      document.getElementById('match-count').textContent = visible;
    }

    function toggleWishlist(btn) {
      const icon = btn.querySelector('.material-symbols-outlined');
      const filled = icon.style.fontVariationSettings.includes('1');
      icon.style.fontVariationSettings = filled ? "'FILL' 0" : "'FILL' 1";
      btn.classList.toggle('text-error', !filled);
    }

    function addToBag(btn) {
      const countEl = document.getElementById('cart-count');
      if (countEl) countEl.textContent = parseInt(countEl.textContent, 10) + 1;
      const span = btn.querySelector('span');
      const prev = span.textContent;
      span.textContent = 'Added to Bag';
      setTimeout(() => { span.textContent = prev; }, 1200);
    }
  </script>


