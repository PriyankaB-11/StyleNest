    function swapPhoto(src) {
      document.getElementById('main-product-img').src = src;
    }
    function selectSize(btn) {
      document.querySelectorAll('.size-btn').forEach(b => {
        b.className = 'size-btn py-2.5 border border-outline-variant font-label text-label-md text-on-surface hover:border-primary transition-colors';
      });
      btn.className = 'size-btn py-2.5 border border-primary bg-primary text-on-primary font-label text-label-md transition-colors';
    }
    function updateQty(delta) {
      const el = document.getElementById('pdp-qty');
      const next = Math.max(1, parseInt(el.textContent, 10) + delta);
      el.textContent = next;
    }
    function toggleWishlist(btn) {
      const icon = btn.querySelector('.material-symbols-outlined');
      const filled = icon.style.fontVariationSettings.includes('1');
      icon.style.fontVariationSettings = filled ? "'FILL' 0" : "'FILL' 1";
      btn.classList.toggle('text-error', !filled);
    }
    function addToBag(btn) {
      const qty = parseInt(document.getElementById('pdp-qty').textContent, 10);
      const countEl = document.getElementById('cart-count');
      if (countEl) countEl.textContent = parseInt(countEl.textContent, 10) + qty;
      const span = btn.querySelector('span[data-design-text-token]');
      const prev = span.textContent;
      span.textContent = 'Added to Bag';
      setTimeout(() => { span.textContent = prev; }, 1200);
    }
  </script>


