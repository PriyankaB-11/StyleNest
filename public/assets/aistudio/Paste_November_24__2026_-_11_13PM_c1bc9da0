  <script>
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuBtn && mobileMenu) menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));

    function recalcBag() {
      let total = 0;
      let count = 0;
      document.querySelectorAll('.cart-item').forEach(row => {
        const price = parseFloat(row.dataset.price);
        const qty = parseInt(row.querySelector('.item-qty').textContent, 10);
        const line = price * qty;
        row.querySelector('.item-total').textContent = '$' + line.toLocaleString('en-US', { minimumFractionDigits: 2 });
        total += line;
        count += qty;
      });
      const fmt = '$' + total.toLocaleString('en-US', { minimumFractionDigits: 2 });
      document.getElementById('bag-subtotal').textContent = fmt;
      document.getElementById('bag-total').textContent = fmt;
      document.getElementById('cart-count').textContent = count;
    }

    function stepItem(btn, delta) {
      const row = btn.closest('.cart-item');
      const qtyEl = row.querySelector('.item-qty');
      qtyEl.textContent = Math.max(1, parseInt(qtyEl.textContent, 10) + delta);
      recalcBag();
    }

    function removeItem(btn) {
      btn.closest('.cart-item').remove();
      recalcBag();
    }
  </script>


