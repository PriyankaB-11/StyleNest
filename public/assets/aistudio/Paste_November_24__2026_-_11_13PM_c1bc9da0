    function filterCategory(cat, btn) {
      document.querySelectorAll('.filter-chip').forEach(c => {
        c.setAttribute('aria-pressed', 'false');
        c.className = 'filter-chip px-5 py-2 rounded-full bg-transparent text-on-surface border border-outline-variant hover:border-primary font-label text-label-sm uppercase tracking-wider transition-colors duration-state-change';
      });
      btn.setAttribute('aria-pressed', 'true');
      btn.className = 'filter-chip px-5 py-2 rounded-full bg-primary text-on-primary font-label text-label-sm uppercase tracking-wider transition-colors duration-state-change';

      let visible = 0;
      document.querySelectorAll('.product-card').forEach(card => {
        const match = cat === 'all' || card.dataset.category === cat;
        card.classList.toggle('hidden', !match);
        if (match) visible++;
      });
      document.getElementById('results-count').textContent = `Showing ${visible} ${visible === 1 ? 'Piece' : 'Pieces'}`;
    }

    function toggleWishlist(btn) {
      const icon = btn.querySelector('.material-symbols-outlined');
      const filled = icon.style.fontVariationSettings.includes('1');
      icon.style.fontVariationSettings = filled ? "'FILL' 0" : "'FILL' 1";
      btn.classList.toggle('text-error', !filled);
    }

    function addToBag(btn) {
      const countEl = document.getElementById('cart-count');
      if (countEl) countEl.textContent = parseInt(countEl.textContent, 10) + 1;
      const span = btn.querySelector('span');
      const prev = span.textContent;
      span.textContent = 'Added to Bag';
      setTimeout(() => { span.textContent = prev; }, 1200);
    }
  </script>


